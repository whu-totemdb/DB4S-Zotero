{
  "name": "ai-for-science",
  "type": "module",
  "version": "1.0.0",
  "description": "Zotero Plugin with AI Chat and MCP Support",
  "config": {
    "addonName": "AI for Science",
    "addonID": "ai_mcp@example.com",
    "addonRef": "ai_mcp",
    "addonInstance": "AiMcp",
    "prefsPrefix": "extensions.zotero.ai_mcp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whu-totemdb/DB4S-Zotero.git"
  },
  "author": "windingwind",
  "bugs": {
    "url": "https://github.com/whu-totemdb/DB4S-Zotero/issues"
  },
  "homepage": "https://github.com/whu-totemdb/DB4S-Zotero#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.1",
    "mocha": "^12.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.1",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
